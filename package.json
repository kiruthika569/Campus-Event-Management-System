{
  "name": "greenfield-campus-events",
  "version": "2.0.0",
  "description": "Greenfield Institute of Technology - Campus Event Management System (React.js + Express + MongoDB)",
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && npm run seed",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "campus-events",
    "event-management",
    "react",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "Greenfield Institute of Technology",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
